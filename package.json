{
  "name": "space-travel",
  "version": "1.1.0",
  "description": "WebGL space scene with lightspeed warp effect",
  "license": "The Unlicense",
  "repository": "frequin/space-travel",
  "author": {
    "name": "Florent Requin",
    "email": "florent.requin@gmail.com"
  },
  "type": "module",
  "module": "./dist/space-travel.es.js",
  "types": "./dist/space-travel.es.d.ts",
  "exports": {
    ".": {
      "types": "./dist/space-travel.es.d.ts",
      "import": "./dist/space-travel.es.js"
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "build": "tsc && vite build",
    "build:demo": "vite build --config demo.vite.config.ts",
    "serve:demo": "vite preview --config demo.vite.config.ts",
    "test": "xo && prettier --check \"**/*.{json,css}\"",
    "prepublishOnly": "npm run test && npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "webgl",
    "canvas",
    "ogl",
    "space",
    "stars",
    "lightspeed"
  ],
  "dependencies": {
    "modern-normalize": "^3.0.1",
    "ogl": "^1.0.11",
    "uint8array-extras": "^1.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@microsoft/api-extractor": "^7.58.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.16",
    "xo": "^2.0.2"
  },
  "lint-staged": {
    "*.{ts,js}": "xo --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
